# Copy to .env and fill in. Never commit the filled-in file.
#
# This is the portable alternative to `. .\setup_env.ps1`, which reads the Aura
# credentials file and dot-sources it into a PowerShell session. Everything that needs
# these values goes through load_neo4j.load_credentials, which reads a .env, so setting
# them here works without PowerShell and without an Aura file on disk.
#
# Precedence, weakest first: the Aura credentials file, then .env, then the environment.

# --- Neo4j AuraDB -----------------------------------------------------------
# These four come from the credentials file Aura gives you when you create an
# instance (Neo4j-<id>-Created-<date>.txt).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# On Aura this is the INSTANCE ID, not "neo4j". Connecting to "neo4j" fails with
# DatabaseNotFound, and that costs an hour to work out.
NEO4J_DATABASE=neo4j

# --- LLM --------------------------------------------------------------------
# OPENAI_API_KEY is preferred. OPENAI_KEY is accepted as a fallback because the
# vendored EDC code reads that name directly; whichever you set, the pipeline
# populates OPENAI_KEY internally so EDC's client works.
OPENAI_API_KEY=
# OPENAI_KEY=
